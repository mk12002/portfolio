{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/projects/study-os", "destination": "/projects/study-os/index.html" },
    { "source": "/projects/study-os/(.*)", "destination": "/projects/study-os/$1" },
    { "source": "/projects", "destination": "/projects/index.html" },
    { "source": "/projects/:slug", "destination": "/projects/:slug/index.html" },
    { "source": "/posts", "destination": "/posts/index.html" },
    { "source": "/experiences", "destination": "/experiences/index.html" },
    { "source": "/publications", "destination": "/publications/index.html" },
    { "source": "/resume", "destination": "/resume/index.html" },
    { "source": "/certificates", "destination": "/certificates/index.html" },
    { "source": "/events", "destination": "/events/index.html" },
    { "source": "/reads", "destination": "/reads/index.html" },
    { "source": "/uses", "destination": "/uses/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/playground", "destination": "/playground/index.html" },
    { "source": "/demos", "destination": "/demos/index.html" },
    { "source": "/case-study", "destination": "/case-study/index.html" },
    { "source": "/ctf", "destination": "/ctf/index.html" },
    { "source": "/support", "destination": "/support/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://api.web3forms.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'sha256-2kvJ4uSs0j0ZtDlPw5Y+7jRCPV7odeWDls9VCttP8HY=' https://va.vercel-scripts.com; connect-src 'self' https://api.web3forms.com https://vitals.vercel-insights.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ]
}
